{
  "name": "agentica",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @agentica/protocol build && pnpm --filter @agentica/desktop tauri dev",
    "dev:backend": "cargo run --locked -p agentica-runtime --bin agentica-backend",
    "dev:web": "pnpm --filter @agentica/protocol build && pnpm --filter @agentica/desktop dev",
    "build": "pnpm -r build && cargo build --locked -p agentica-runtime",
    "build:desktop": "pnpm --filter @agentica/protocol build && pnpm --filter @agentica/desktop tauri build --no-bundle",
    "check": "pnpm --filter @agentica/protocol build && pnpm -r check",
    "check:rust": "cargo fmt --all --check && cargo clippy --locked --workspace --all-targets --all-features -- -D warnings",
    "test:rust": "cargo test --locked --workspace",
    "test": "pnpm --filter @agentica/protocol build && cargo test --locked -p agentica-runtime && cargo build --locked -p agentica-runtime && node --test",
    "build:backend": "cargo build --locked --release -p agentica-runtime --bin agentica-backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@agentica/protocol": "workspace:*",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.3"
  }
}
