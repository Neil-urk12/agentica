{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window may exchange validated runtime requests, send provider Chat Completions requests over HTTPS or localhost HTTP, and protect unsaved edits when closing.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-request",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*/*chat/completions" },
        { "url": "http://localhost:*/*chat/completions" },
        { "url": "http://127.0.0.1:*/*chat/completions" }
      ]
    },
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
